import requests
import json

# Get your Datadog API key securely from Databricks secret scope
api_key = dbutils.secrets.get(scope="datadog-secrets", key="api_key")

# Datadog Logs HTTP endpoint (for US region)
url = "https://http-intake.logs.datadoghq.com/v1/input"

# Prepare your log message
log_data = {
    "message": "Hello from Azure Databricks!",
    "ddsource": "databricks",
    "service": "my-databricks-job",
    "hostname": "my-cluster",
    "status": "info"
}

# Headers including your API key
headers = {
    "Content-Type": "application/json",
    "DD-API-KEY": api_key
}

# Send the log to Datadog
response = requests.post(url, headers=headers, data=json.dumps(log_data))

# Optional: print response status
print(f"Status Code: {response.status_code}")
