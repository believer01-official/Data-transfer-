import requests
from requests.auth import HTTPBasicAuth

# Replace with your ServiceNow instance and credentials
instance = 'your_instance'  # e.g., 'dev12345'
username = 'your_username'
password = 'your_password'

# Use a lightweight endpoint just to check connection (no CRUD)
url = f'https://{instance}.service-now.com/api/now/table/sys_user?sysparm_limit=1'

# Set headers
headers = {
    "Accept": "application/json"
}

# Make the GET request to test connection
response = requests.get(url, auth=HTTPBasicAuth(username, password), headers=headers)

# Check if connection was successful
if response.status_code == 200:
    print("Connection to ServiceNow successful!")
else:
    print(f"Failed to connect. Status code: {response.status_code}")
    print(response.text)
